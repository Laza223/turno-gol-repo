# Dockerfile para el servicio de WORKERS (pg-boss), no para la web.
# La web (Next.js) se deploya en Vercel; este contenedor corre el proceso
# Node 24/7 que procesa los background jobs (`pnpm jobs:start`).
#
# Pensado para Railway / Render / Fly.io. Los workers corren con tsx
# (sin build): se ejecuta TypeScript directo, igual que en local.
#
# Ver docs/infraestructura.md.

FROM node:22-slim

# pnpm vía corepack, pinneado a la versión del repo (packageManager).
RUN corepack enable && corepack prepare pnpm@10.34.5 --activate

WORKDIR /app

# Instalar dependencias primero (capa cacheable). Se instalan TODAS las deps
# —incluida tsx (devDependency)— porque el worker se ejecuta con tsx.
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# Código fuente (tsx resuelve los alias `@/` desde tsconfig.json).
COPY . .

# Se setea NODE_ENV recién acá: antes haría que pnpm omita devDependencies.
ENV NODE_ENV=production

# Entrypoint: arranca pg-boss + registra los 14 workers.
#
# El recordatorio que había acá quedó DESACTUALIZADO y era peligroso: decía que
# DATABASE_URL debía ser la conexión DIRECTA a Postgres (:5432) y llevar
# `?sslmode=require`. Las dos cosas son falsas hoy, y la segunda fue la causa
# de un incidente (2026-08-25):
#
#   * La conexión directa (`db.<ref>.supabase.co:5432`) ya NO EXISTE — da
#     ENOTFOUND. Todo el tráfico pasa por el pooler, sí o sí.
#   * `?sslmode=require` hacía que `pg` (la librería de pg-boss) validara la
#     cadena SIN tener la CA de Supabase, y el worker moría en bucle con
#     "self-signed certificate in certificate chain".
#
# Hoy el `sslmode` del DSN NO decide nada: `pgConnectionConfig()` se lo saca
# antes de dárselo a `pg`, y el TLS lo fija el código (`src/shared/db/ssl.ts`),
# que además ya valida la cadena contra la raíz de Supabase. Ver
# docs/audit/2026-08-25-auditoria-infra.md §11-12 y §22, y el mismo
# razonamiento en railway.toml.
CMD ["pnpm", "jobs:start"]
