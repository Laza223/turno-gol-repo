# ─────────────────────────────────────────────────────────────────────────
# Staging environment — TurnoGol
#
# Copy to .env.staging and fill in real values, OR set these as env vars on
# whatever platform hosts staging (Vercel Preview/staging deployment →
# Project Settings → Environment Variables → scope "Preview").
#
# Source of truth for what's REQUIRED to boot: src/shared/env.ts
# (validateServerEnv throws on missing/invalid vars — same schema as prod).
# scripts/staging-check.ts checks all of REQUIRED_ENV below plus a handful
# of live probes (RLS, MP creds, migrations, /api/status).
#
# NEVER commit a real .env.staging — it's gitignored like .env.local.
# ─────────────────────────────────────────────────────────────────────────

# ── Runtime ─────────────────────────────────────────────────────────────
# Vercel sets NODE_ENV=production for every deployed build (preview included),
# so this doesn't distinguish staging from prod on its own — seed-staging.ts
# and staging-check.ts key off NEXT_PUBLIC_APP_URL / VERCEL_ENV instead.
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://staging.turnogol.app

# ── Supabase ────────────────────────────────────────────────────────────
# Use a SEPARATE Supabase project from prod (Supabase dashboard → New
# Project). Do not point staging at the prod project — seeds/tests will
# write real-looking rows into it.
# Values: Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Supabase dashboard → Project Settings → Database → Connection string (URI,
# "Session pooler" or direct — direct is simplest for scripts/migrations).
# sslmode=require SOLO para DSNs remotos (Supabase) — localhost no usa SSL.
DATABASE_URL=postgres://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres?sslmode=require

# ── MercadoPago ─────────────────────────────────────────────────────────
# MP dashboard (https://www.mercadopago.com.ar/developers/panel) → your
# integration app → "Credenciales de producción" tab has CLIENT_ID/SECRET
# for OAuth (used for per-tenant deposit charges, doc11 ADR-004/010).
# For staging you almost certainly want MP_MOCK_MODE=1 instead of real
# credentials — see src/modules/payments/mock-mp.ts. If MP_MOCK_MODE=1,
# CLIENT_ID/SECRET/WEBHOOK_SECRET can be any non-empty placeholder (env.ts
# still requires them to be present, just not valid).
MP_CLIENT_ID=xxx
MP_CLIENT_SECRET=xxx
MP_WEBHOOK_SECRET=xxx
# 1 = mock MercadoPago gateway, no real API calls / no real charges.
# Hard-disabled in production by src/modules/payments/mock-mp.ts regardless
# of this flag, so it's safe to leave set. Recommended for staging.
MP_MOCK_MODE=1

# ── Secrets (generate fresh — never reuse prod's) ──────────────────────
# openssl rand -hex 32
ENCRYPTION_KEY=
# openssl rand -hex 24
IMPERSONATION_COOKIE_SECRET=

# ── Email (Resend) ──────────────────────────────────────────────────────
# https://resend.com/api-keys — a staging-scoped key (or reuse prod's test
# mode key) so staging traffic doesn't count against/pollute prod sending.
RESEND_API_KEY=re_xxx

# ── Error tracking (Sentry) ─────────────────────────────────────────────
# Sentry dashboard → your project → Settings → Client Keys (DSN). Use a
# separate Sentry project (or environment tag) from prod so staging noise
# doesn't page anyone — sentry.*.config.ts sets environment=NODE_ENV, which
# staging can't distinguish from prod (see NODE_ENV note above), so a
# dedicated Sentry project is the cleaner separation.
SENTRY_DSN=https://xxx@sentry.io/xxx
NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx
# Only needed at BUILD time (sourcemap upload, next.config.js) — Sentry
# dashboard → Settings → Auth Tokens. Org/project slugs are in the URL.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Rate limiting (Upstash Redis) ───────────────────────────────────────
# https://console.upstash.com — create a small/free Redis DB for staging
# (do NOT point at prod's — shared rate-limit counters would cross-pollute).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Web Push (VAPID) ─────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:staging@turnogol.app
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── SuperAdmin allowlist (optional) ──────────────────────────────────────
# Comma-separated emails allowed into /super-admin/*. Fail-closed if unset.
SYSTEM_ADMIN_EMAILS=

# ── scripts/seed-staging.ts ──────────────────────────────────────────────
# Password for the seeded staging admin test user. No default on purpose —
# pick a fresh value, don't reuse anything real.
STAGING_ADMIN_PASSWORD=
STAGING_ADMIN_EMAIL=staging-admin@turnogol.test

# ── Webhook Harness (MP-WEBHOOK-001) ────────────────────────────────────
MP_WEBHOOK_TEST_BYPASS_SECRET=
WEBHOOK_HARNESS_TENANT_ALLOWLIST=
STAGING_BASE_URL=

# ── Background Workers (DSN Dual) ────────────────────────────────────────
# Dedicated role for workers to bypass RLS correctly. Conexión DIRECTA :5432
# (no el pooler) — agregar ?sslmode=require al armar el valor real (DSN
# remoto de Supabase; localhost no usa SSL).
WORKER_DATABASE_URL=
