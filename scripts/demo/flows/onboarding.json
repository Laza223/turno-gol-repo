{
  "name": "onboarding",
  "auth": "fresh",
  "viewport": "mobile",
  "steps": [
    { "action": "caption", "text": "Creá tu complejo en 4 pasos" },
    { "action": "goto", "url": "/onboarding" },
    { "action": "pause", "ms": 1800 },
    { "action": "caption", "text": "1 — Los datos de tu complejo" },
    { "action": "fill", "css": "#identity-name", "text": "Complejo El Potrero" },
    { "action": "fill", "css": "#identity-address", "text": "Av. Mitre 1850", "fast": true },
    { "action": "fill", "css": "#identity-city", "text": "Avellaneda", "fast": true },
    { "action": "select", "css": "#identity-province", "value": "Buenos Aires" },
    { "action": "fill", "css": "#identity-phone", "text": "+5491144556677", "fast": true },
    { "action": "fill", "css": "#identity-email", "text": "hola@elpotrero.com.ar", "fast": true },
    { "action": "click", "name": "re:Continuar" },
    { "action": "pause", "ms": 1400 },
    { "action": "caption", "text": "2 — Horarios (vienen listos, los tocás si querés)" },
    { "action": "pause", "ms": 1400 },
    { "action": "click", "name": "re:Continuar" },
    { "action": "pause", "ms": 1200 },
    { "action": "caption", "text": "3 — Tus canchas y el precio" },
    { "action": "fill", "placeholder": "20\\.000", "text": "40.000" },
    { "action": "pause", "ms": 900 },
    { "action": "click", "name": "re:Continuar" },
    { "action": "pause", "ms": 1200 },
    { "action": "caption", "text": "4 — ¿Cobrás seña online?" },
    { "action": "clickText", "text": "Sin seña por ahora" },
    { "action": "pause", "ms": 800 },
    { "action": "click", "name": "re:Terminar y ver mi complejo" },
    { "action": "waitText", "text": "Ir a mi panel" },
    { "action": "caption", "text": "Listo: tu complejo ya está online" },
    { "action": "pause", "ms": 2200 },
    { "action": "click", "role": "link", "name": "re:Ir a mi panel" },
    { "action": "pause", "ms": 2200 },
    { "action": "caption", "text": "De cero a recibir reservas: una tarde — TurnoGol" },
    { "action": "pause", "ms": 2000 }
  ]
}
