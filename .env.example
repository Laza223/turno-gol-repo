# ─────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Web (Vercel): pooler Supavisor :6543 + ?pgbouncer=true&sslmode=require
# Workers (Railway): conexión directa :5432 con rol BYPASSRLS + ?sslmode=require
# sslmode=require SOLO para DSNs remotos (Supabase) — localhost no usa SSL.
DATABASE_URL=postgres://user:pass@host:6543/db?pgbouncer=true&sslmode=require
# Conexiones por instancia (default 3, serverless-safe). Subir SOLO en workers (proceso único).
# DATABASE_POOL_MAX=3

# ─────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────
# URL absoluta SIN slash final. Usada en redirect OAuth MP, magic links, invitaciones staff.
NEXT_PUBLIC_APP_URL=https://turnogol.app
# Misma URL — la usan las suscripciones SaaS MP (notification_url). Sin esto el fallback es localhost.
APP_URL=https://turnogol.app
# URLs canónicas/OG de SEO.
NEXT_PUBLIC_SITE_URL=https://turnogol.app
# Secret de cookies firmadas (≥16 chars aleatorios): openssl rand -hex 16
IMPERSONATION_COOKIE_SECRET=
# Cifrado at-rest de tokens OAuth MP de tenants. EXACTAMENTE 64 hex chars (32 bytes): openssl rand -hex 32
ENCRYPTION_KEY=
# Versión de términos aceptados (default v1)
# TERMS_VERSION=v1

# ─────────────────────────────────────────────────
# MercadoPago
# ─────────────────────────────────────────────────
# Credenciales de la aplicación (panel MP Developers) — OAuth por tenant para señas
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Clave secreta de la pantalla de Webhooks del panel MP
MP_WEBHOOK_SECRET=
# Access token de la cuenta master TurnoGol — cobra las suscripciones SaaS (preapproval)
MP_TURNOGOL_ACCESS_TOKEN=

# ─────────────────────────────────────────────────
# Email (Resend) — From hardcodeado: no-reply@turnogol.app (dominio verificado en Resend)
# ─────────────────────────────────────────────────
RESEND_API_KEY=re_xxx

# ─────────────────────────────────────────────────
# Error Tracking (Sentry)
# ─────────────────────────────────────────────────
SENTRY_DSN=https://xxx@sentry.io/xxx
NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx
# Source maps en build (CI/Vercel):
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# ─────────────────────────────────────────────────
# Upstash Redis (rate limiting + cache de slots)
# ─────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─────────────────────────────────────────────────
# Web Push (npx web-push generate-vapid-keys)
# ─────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@turnogol.app
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ─────────────────────────────────────────────────
# Cloudflare R2 (Media Storage)
# ─────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=turnogol-media
R2_PUBLIC_BASE_URL=https://media.turnogol.com

# ─────────────────────────────────────────────────
# SOLO dev/test — AUSENTES en producción
# ─────────────────────────────────────────────────
# MP_MOCK_MODE=1        # mock de MP (hard-gate: nunca activa en prod)
# NEXT_PUBLIC_E2E=1     # bypass rate-limit + seed E2E (launch:check falla si está)
