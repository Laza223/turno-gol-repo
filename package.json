{
  "name": "turnogol",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts,.tsx",
    "format": "prettier --write src/",
    "test": "vitest run --dir tests/unit",
    "test:integration": "vitest run --dir tests/integration",
    "test:isolation": "vitest run tests/integration/isolation.test.ts",
    "test:e2e": "playwright test",
    "db:push": "drizzle-kit push:pg",
    "db:migrate": "drizzle-kit push:pg",
    "db:generate": "drizzle-kit generate:pg",
    "db:studio": "drizzle-kit studio",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "db:sync-supabase": "node scripts/sync-supabase-migrations.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.0",
    "@radix-ui/react-dialog": "^1.0",
    "@radix-ui/react-dropdown-menu": "^2.0",
    "@radix-ui/react-select": "^2.0",
    "@radix-ui/react-toast": "^1.1",
    "@sentry/nextjs": "^7.110",
    "@supabase/ssr": "^0.3",
    "@supabase/supabase-js": "^2.43",
    "class-variance-authority": "^0.7",
    "clsx": "^2.1",
    "date-fns": "^3.6",
    "date-fns-tz": "^3.1",
    "drizzle-orm": "^0.30",
    "lucide-react": "^1.11.0",
    "mercadopago": "^2.0",
    "nanoid": "^5.0",
    "next": "^14.2",
    "pg-boss": "^9.0",
    "postgres": "^3.4",
    "react": "^18.3",
    "react-dom": "^18.3",
    "resend": "^3.2",
    "tailwind-merge": "^2.3",
    "zod": "^3.23"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4",
    "@playwright/test": "^1.43",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^7",
    "@typescript-eslint/parser": "^7",
    "autoprefixer": "^10",
    "dotenv": "^16.4",
    "drizzle-kit": "^0.20",
    "eslint": "^8",
    "eslint-config-next": "^14",
    "postcss": "^8",
    "prettier": "^3.2",
    "supabase": "^1.150",
    "tailwindcss": "^3.4",
    "tailwindcss-animate": "^1.0",
    "typescript": "^5.4",
    "vitest": "^1.6"
  }
}
