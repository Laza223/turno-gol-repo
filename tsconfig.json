{
  "compilerOptions": {
    // Explícito a propósito: sin `target`, tsc cae en su default (ES5), que TS 6
    // marca como deprecado. El emit real lo hace SWC (Next) y acá está noEmit,
    // así que esto sólo afecta al type-checking.
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "ui-ux-pro-max-skill", ".worktrees", "TurnoGol-audit-f02"]
}
