# Copy to .env.test and adjust if needed.
# Default points at Supabase local CLI (supabase start).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres


# Upstash mocked in tests; leave empty.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# E2E
NEXT_PUBLIC_E2E=1
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
E2E_BASE_URL=http://localhost:3000

# E2E/local only — mock MercadoPago (no real API calls / no real charges).
# Leave UNSET in production. CI must export MP_MOCK_MODE=1 for the E2E job.
MP_MOCK_MODE=1

# Webhook secret for mock checkout E2E posts.
MP_WEBHOOK_SECRET=test-webhook-secret

# Web Push notifications (Fase F9) — deterministic test placeholders (not real VAPID keys)
# Long enough to pass Zod minLen(80) / minLen(40). web-push is stubbed in unit tests.
VAPID_PUBLIC_KEY=BJzYxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_PRIVATE_KEY=AAAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_SUBJECT=mailto:test@turnogol.local
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BJzYxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
