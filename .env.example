# ─────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
DATABASE_URL=postgres://user:pass@host:5432/db

# ─────────────────────────────────────────────────
# MercadoPago
# ─────────────────────────────────────────────────
MP_ACCESS_TOKEN=APP_USR-xxx
MP_PUBLIC_KEY=APP_USR-xxx
MP_WEBHOOK_SECRET=xxx

# ─────────────────────────────────────────────────
# Email (Resend)
# ─────────────────────────────────────────────────
RESEND_API_KEY=re_xxx
EMAIL_FROM=noreply@turnogol.com.ar

# ─────────────────────────────────────────────────
# Error Tracking (Sentry)
# ─────────────────────────────────────────────────
SENTRY_DSN=https://xxx@sentry.io/xxx
NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx

# ─────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://turnogol.com.ar
NODE_ENV=production


# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# E2E/local only — mock MercadoPago (no real API calls / no real charges).
# Leave UNSET in production. CI must export MP_MOCK_MODE=1 for the E2E job.
# MP_MOCK_MODE=1
