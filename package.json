{
  "name": "turnogol",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20.9"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "last 2 Chrome versions",
      "last 2 Firefox versions",
      "Firefox ESR",
      "last 2 Safari versions",
      "last 2 iOS versions",
      "last 2 ChromeAndroid versions",
      "Edge >= 108",
      "not dead",
      "not op_mini all",
      "not IE 11"
    ],
    "development": [
      "last 1 Chrome version",
      "last 1 Firefox version",
      "last 1 Safari version"
    ]
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/ scripts/",
    "knip": "knip",
    "depcruise": "depcruise src --config .dependency-cruiser.mjs",
    "depcruise:graph": "depcruise src --config .dependency-cruiser.mjs --output-type mermaid --output-to docs/architecture-graph.mmd",
    "scan": "react-scan http://localhost:3000",
    "format": "prettier --write src/ tests/ scripts/",
    "format:check": "prettier --check src/ tests/ scripts/",
    "test": "vitest run tests/unit src",
    "test:integration": "vitest run --dir tests/integration --exclude \"**/isolation.test.ts\" --exclude \"**/isolation-app-role.test.ts\" --exclude \"**/mis-reservas-app-role.test.ts\" --exclude \"**/rival-db-app-role.test.ts\" --exclude \"**/rival-service-app-role.test.ts\"",
    "test:isolation": "vitest run tests/integration/isolation.test.ts",
    "test:bot-bench": "vitest run tests/bot-bench",
    "test:isolation:rol-real": "vitest run tests/integration/isolation-app-role.test.ts tests/integration/mis-reservas-app-role.test.ts tests/integration/rival-db-app-role.test.ts tests/integration/rival-service-app-role.test.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "test:storybook:ci": "vitest run --config vitest.storybook.config.ts --reporter=default",
    "test:storybook:dark": "cross-env STORYBOOK_THEME=dark vitest run --config vitest.storybook.config.ts --reporter=default",
    "qa:storybook": "node scripts/storybook-qa.mjs",
    "qa:coverage": "node scripts/verify-story-coverage.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --project chromium --reporter=github,html && playwright test --project mobile-chrome --reporter=github,html && playwright test --project axe-audit --reporter=github,html",
    "test:e2e:cross-browser": "playwright test --project webkit --project firefox --project mobile-safari",
    "test:e2e:flake-detect": "playwright test --project chromium --grep @critical --repeat-each=10 --retries=0 --workers=1",
    "e2e:seed": "tsx scripts/seed-e2e.ts",
    "seed:system-admin": "tsx scripts/seed-system-admin.ts",
    "stress:bookings": "tsx scripts/stress-test.ts",
    "audit:loadsmoke": "tsx scripts/audit/loadsmoke-d3.ts",
    "audit:corpus": "tsx scripts/audit/capture-corpus.ts",
    "launch:check": "tsx scripts/launch-check.ts",
    "sentry:issues": "tsx scripts/sentry-issues.ts",
    "staging:check": "tsx scripts/staging-check.ts",
    "staging:seed": "tsx scripts/seed-staging.ts",
    "webhook:replay": "tsx scripts/replay-mp-webhook.ts",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "db:sync-supabase": "node scripts/sync-supabase-migrations.mjs",
    "bootstrap:local-roles": "node scripts/bootstrap-local-roles.mjs",
    "jobs:start": "tsx src/shared/jobs/run-workers.ts",
    "semgrep": "node scripts/semgrep.mjs",
    "semgrep:all": "node scripts/semgrep.mjs --config .semgrep/rules --config p/nextjs --config p/github-actions --config p/docker",
    "semgrep:test": "node scripts/semgrep.mjs --test",
    "semgrep:diff": "node scripts/semgrep.mjs --baseline-commit origin/main",
    "analyze": "cross-env ANALYZE=true next build",
    "lighthouse": "lhci autorun",
    "lighthouse:grilla": "tsx scripts/lighthouse-grilla.ts",
    "lighthouse:public": "tsx scripts/lighthouse-public.ts",
    "doctor": "npx react-doctor@latest",
    "ig:follow": "node scripts/ig-follow/follow.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.137.0",
    "@aws-sdk/client-s3": "^3.1159.0",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sentry/nextjs": "10.78.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.40.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.45.4",
    "gray-matter": "^4.0.3",
    "leaflet": "1.9.4",
    "lucide-react": "^1.63.0",
    "mercadopago": "^2.13.0",
    "motion": "^13.5.1",
    "next": "16.4.3",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "pg-boss": "^9.0.3",
    "postgres": "^3.4.9",
    "react": "~19.2.9",
    "react-dom": "~19.2.9",
    "react-leaflet": "5.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.35.0",
    "tailwind-merge": "^3.7.0",
    "web-push": "^3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@faker-js/faker": "^10.6.0",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "16.4.3",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/nextjs-vite": "10.6.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/autocannon": "^7.12.7",
    "@types/leaflet": "1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@types/web-push": "^3.6.4",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "autocannon": "^8.0.0",
    "cross-env": "^10.1.0",
    "dependency-cruiser": "^18.7.0",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "happy-dom": "^21.0.4",
    "knip": "^6.43.0",
    "playwright": "1.64.1",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "react-scan": "^0.5.7",
    "storybook": "10.6.5",
    "supabase": "^1.226.4",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
